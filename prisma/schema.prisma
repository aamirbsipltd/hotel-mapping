generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Session {
  id              String   @id @default(cuid())
  uploadedAt      DateTime @default(now())
  expiresAt       DateTime
  isPaid          Boolean  @default(false)
  stripeSessionId String?
  byok            Boolean  @default(false)
  byokKey         String?
  rowsTotal       Int
  rowsProcessed   Int      @default(0)
  status          String   @default("queued")
  errorMessage    String?
  matches         Match[]

  @@index([expiresAt])
}

model Match {
  id                 String   @id @default(cuid())
  sessionId          String
  session            Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  rowIndex           Int
  sourceId           String
  sourceName         String
  sourceCity         String?
  sourceCountry      String?
  sourceLat          Float?
  sourceLng          Float?
  sourceAddress      String?
  sourcePhone        String?
  status             String
  candidatesJson     String?
  selectedLocationId String?
  selectedConfidence Float?
  errorMessage       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([sessionId, rowIndex])
}

// ── FastX amenities classifier ───────────────────────────────────────────────
// Learned mapping dictionary. Each row is a stable supplier-side identifier
// (Travelgate canonical code, GIATA code, or a normalised text token) bound
// to one of the canonical category IDs in src/fastx/taxonomy.ts. The seed
// rows are inserted at build/dev time; review-queue decisions append further
// rows so the dictionary compounds across runs and suppliers.
model AmenityMapping {
  id         String   @id @default(cuid())
  key        String   @unique
  keyType    String   // TGX | GIATA | SUPPLIER | TEXT
  categoryId String
  source     String   // SEED | REVIEW
  createdAt  DateTime @default(now())

  @@index([categoryId])
}

model ClassificationRun {
  id         String       @id @default(cuid())
  hotelCode  String
  hotelName  String?
  stats      String       // serialised JSON: { total, auto, review, payment, nearby, excluded, autoRate, autoRateDenominator }
  result     String       // serialised JSON: ClassifyResult — the full categorised result snapshot at run-create time
  createdAt  DateTime     @default(now())
  reviewItems ReviewItem[]

  @@index([hotelCode])
}

model ReviewItem {
  id                   String   @id @default(cuid())
  runId                String
  run                  ClassificationRun @relation(fields: [runId], references: [id], onDelete: Cascade)
  rawText              String
  sourceField          String   // amenity | cardTypes | poi
  suggestedCategoryId  String?
  resolvedCategoryId   String?
  confidence           Float
  method               String   // exact | fuzzy | none
  status               String   @default("PENDING") // PENDING | RESOLVED
  mappingKey           String?  // populated on resolve so re-runs hit the exact-map stage
  mappingKeyType       String?
  createdAt            DateTime @default(now())
  resolvedAt           DateTime?

  @@index([runId, status])
}

// ── Region mapping ───────────────────────────────────────────────────────────
// Country → Destination → Region hierarchy. GeoJSON polygons + precomputed
// centroid/bbox live on Region so the in-memory rbush index does not have to
// recompute them per run. polygon and bbox are stored as serialised JSON
// strings (TEXT) — Prisma's Json column type isn't supported under the
// libsql/SQLite adapter; the Postgres migration noted in memory will swap
// these to Json/jsonb (and the production path swaps to PostGIS geometry,
// see README §9).
model Country {
  id           String        @id @default(cuid())
  code         String        @unique // ISO-3166-1 alpha-2: "AE", "ES"
  name         String
  destinations Destination[]
}

model Destination {
  id        String   @id @default(cuid())
  countryId String
  country   Country  @relation(fields: [countryId], references: [id], onDelete: Cascade)
  name      String
  slug      String   @unique
  regions   Region[]

  @@index([countryId])
}

model Region {
  id            String             @id @default(cuid())
  destinationId String
  destination   Destination        @relation(fields: [destinationId], references: [id], onDelete: Cascade)
  name          String
  slug          String             @unique
  polygon       String             // GeoJSON Polygon/MultiPolygon, serialised
  centroidLat   Float
  centroidLng   Float
  bbox          String             // serialised [minLng,minLat,maxLng,maxLat]
  source        String             // SEED | OSM | MANUAL
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt
  assignments   RegionAssignment[]

  @@index([destinationId])
}

// One current assignment per hotelKey. method=MANUAL or isOverride=true means
// batch assignment skips the row — manual decisions survive re-runs.
model RegionAssignment {
  id                 String   @id @default(cuid())
  hotelKey           String   @unique
  regionId           String?
  region             Region?  @relation(fields: [regionId], references: [id], onDelete: SetNull)
  method             String   // AUTO | MANUAL | UNASSIGNED
  isOverride         Boolean  @default(false)
  confidence         Float?
  candidateRegionIds String?  // serialised JSON array of regionId strings
  assignedAt         DateTime @default(now())

  @@index([regionId])
}

model AssignmentRun {
  id        String   @id @default(cuid())
  stats     String   // serialised JSON: { total, auto, manualPreserved, review, unassigned }
  createdAt DateTime @default(now())
}
